# Git LFS configuration for large model files

# Track all model files with Git LFS
model/*.joblib filter=lfs diff=lfs merge=lfs -text
model/*.h5 filter=lfs diff=lfs merge=lfs -text
model/*.keras filter=lfs diff=lfs merge=lfs -text
model/*_savedmodel/** filter=lfs diff=lfs merge=lfs -text

# Track large JSON metadata files
model/*_metadata*.json filter=lfs diff=lfs merge=lfs -text
model/training_results.json filter=lfs diff=lfs merge=lfs -text

# Optional: Track other large files if needed
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
